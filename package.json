{
	"name": "obsidian-sample-plugin",
	"version": "1.0.1",
	"description": "Obsidian plugin for Cosense-style link preview cards and two-hop navigation.",
	"main": "main.js",
	"scripts": {
		"dev": "bun run esbuild.config.mjs",
		"build": "bun run esbuild.config.mjs production",
		"release": "bun run build && node release.mjs",
		"test": "vitest run --project node --project dom-unit --project dom-svelte --project jsdom",
		"test:unit": "vitest run --project node",
		"test:dom-all": "vitest run --project dom-unit --project dom-svelte --project jsdom",
		"test:dom-unit": "vitest run --project dom-unit",
		"test:dom-svelte": "vitest run --project dom-svelte",
		"test:perf": "vitest run --project perf",
		"test:watch": "vitest --watch",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"check": "tsc --noEmit && echo tsc passed && svelte-check --tsconfig ./tsconfig.json",
		"check:circular": "madge --circular --extensions ts --ts-config tsconfig.json src",
		"format": "prettier --write \"src/**/*.{ts,svelte}\"",
		"format:staged": "pretty-quick --staged",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "latest",
		"@lezer/common": "latest",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.19.19",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"@vitest/coverage-v8": "^4.1.7",
		"@vitest/ui": "^4.1.7",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.23.1",
		"esbuild-plugin-inline-worker": "^0.1.1",
		"esbuild-svelte": "^0.9.5",
		"jsdom": "^29.1.1",
		"madge": "^8.0.0",
		"obsidian": "latest",
		"obsidian-typings": "^6.13.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"pretty-quick": "^4.2.2",
		"svelte": "5.40.2",
		"svelte-check": "^4.4.8",
		"svelte-preprocess": "^6.0.5",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"monkey-around": "^3.0.0",
		"zod": "^4.4.3"
	}
}
